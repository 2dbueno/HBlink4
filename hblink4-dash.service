[Unit]
Description=HBlink4 Dashboard
After=network.target hblink4.service
Wants=hblink4.service

[Service]
Type=simple
User=cort
Group=cort
WorkingDirectory=/home/cort/hblink4
ExecStart=/home/cort/hblink4/venv/bin/hblink4-dashboard
Restart=always
RestartSec=10

# Security hardening
# NOTE: do not add PrivateTmp=true here. See the note in hblink4.service --
# a private /tmp breaks the 'unix' event transport between the two services.
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hblink4-dash

[Install]
WantedBy=multi-user.target
