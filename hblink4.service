# NOTE: this file ships with the author's user and install paths. Change User=,
# Group=, WorkingDirectory= and ExecStart= below to match your system.
# Edit the installed copy in /etc/systemd/system/, not this one, and run
# "sudo systemctl daemon-reload" after any change. See SYSTEMD.md.
[Unit]
Description=HBlink4 DMR Server
After=network.target

[Service]
Type=simple
User=cort
Group=cort
WorkingDirectory=/home/cort/hblink4
ExecStart=/home/cort/hblink4/venv/bin/python /home/cort/hblink4/hblink4/hblink.py /home/cort/hblink4/config/config.json
Restart=always
RestartSec=10

# Security hardening
# NOTE: do not add PrivateTmp=true here. It gives each service its own /tmp
# namespace, so hblink4 and the dashboard would each create a private
# /tmp/hblink4.sock and never see each other's -- silently breaking the
# 'unix' event transport.
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hblink4

[Install]
WantedBy=multi-user.target
