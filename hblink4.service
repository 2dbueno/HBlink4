[Unit]
Description=HBlink4 DMR Server
After=network.target

[Service]
Type=simple
User=cort
Group=cort
WorkingDirectory=/home/cort/hblink4
ExecStart=/home/cort/hblink4/venv/bin/hblink4 /home/cort/hblink4/config/config.json
Restart=always
RestartSec=10

# Security hardening
# NOTE: do not add PrivateTmp=true here. It gives each service its own /tmp
# namespace, so hblink4 and the dashboard would each create a private
# /tmp/hblink4.sock and never see each other's -- silently breaking the
# 'unix' event transport.
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hblink4

[Install]
WantedBy=multi-user.target
